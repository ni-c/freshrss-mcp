{
  "compilerOptions": {
    "target": "ES2023",
    // ES2024 for `String.prototype.toWellFormed`, which every supported Node
    // (>= 22) has: a lone surrogate out of `&#xD800;` or a `\ud800` escape in
    // the instance's JSON must leave this server as U+FFFD, not as a string a
    // UTF-8 encoder on the client side refuses.
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "sourceMap": true,
    "types": ["node"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
